// Question 5 - What is the percentage of customers who increase their closing balance by more than 5%?
// Question requirements unclear so taken as from first month to last month 
// Continuing on from Question 4

// Extract the first and last months for each customer
// If months differed per customer, use first and last value however with scaffold first is 1 and last is 4 so extract values for each

first_and_last as (select customer_id
, max(case when txn_month = 1 then closing_balance_per_month end) as first_month_balance
, max(case when txn_month = 4 then closing_balance_per_month end) as last_month_balance
from closing_balance_per_month
group by customer_id
),

// Calculate increase in closing balance
pct_increase as (select customer_id
, (last_month_balance - first_month_balance)/first_month_balance as pct_increase
from first_and_last
)

// Calculate percentage of customers that have a 5% and above increase
select 
count(case when pct_increase > 5 then 1 end) as increase_5_customers
, count(customer_id) as total_customers
, round(count(case when pct_increase > 5 then 1 end) / count(customer_id) * 100,2) as pct_customers
from pct_increase;


