// Question 1 - What is the unique count and total amount for each transaction type?
select txn_type
, sum(txn_amount) as total_amount
, count(distinct txn_amount) as unique_count
from customer_transactions
group by txn_type;

// Question 2 - What is the average total historical deposit counts and amounts for all customers?
with customer_amount as (select customer_id
, count(txn_type) as count_txn_type
, sum(txn_amount) as total_amount
from customer_transactions
where txn_type = 'deposit'
group by customer_id
)

select avg(count_txn_type) as avg_deposits
, avg(total_amount) as avg_amount
from customer_amount;


// Question 3 - For each month - how many Data Bank customers make more than 1 deposit and either 1 purchase or 1 withdrawal in a single month?
with transaction_month as (select *
, date_part('month', txn_date) as txn_month
from customer_transactions
), 

// Convert strings to number counts
transaction_types as (select customer_id
, txn_month
, case when txn_type = 'deposit' then 1 else 0 
    end as deposit
, case when txn_type = 'purchase' then 1 else 0 
    end as purchase
, case when txn_type = 'withdrawal' then 1 else 0
    end as withdrawal
from transaction_month
),

// Count how many of each were done per month
sum_transaction_types as (select customer_id
, txn_month
, sum(deposit) as deposit
, sum(purchase) as purchase
, sum(withdrawal) as withdrawal
from transaction_types
group by customer_id, txn_month
)

// Add in condition
select customer_id
, deposit
, withdrawal
, purchase
from sum_transaction_types
where deposit > 1 and coalesce(purchase, withdrawal)>=1;


// Question 4 - What is the closing balance for each customer at the end of the month?

// Find month and create - and + values for different txn_types
with transaction_month as (select customer_id
, txn_type
, date_part('month', txn_date) as txn_month
, case when txn_type in ('withdrawal', 'purchase') then -txn_amount
    else txn_amount
    end as txn_amount
from customer_transactions
),

// txn_amout per active month
txn_amount_per_active_month as (select customer_id
, txn_month
, sum(txn_amount) as balance_amount
from transaction_month
group by customer_id, txn_month
order by customer_id, txn_month
),

//'active_month' added in CTE name above as where some customers had no activity for a month, closing balance should show as same as previous month, so set up to reflect this
// Generate months
months as (select row_number() over( 
    order by seq4()) as txn_month
from table(generator(rowcount => 4))
), 

// Create scaffold to have all 4 months against every customer
data_scaffold as (select ct.customer_id
, m.txn_month
from (select distinct customer_id
    from customer_transactions
    ) ct
cross join months m
), 

// Merge back to the other table
txn_amount_per_month as 
(select ds.customer_id
, ds.txn_month
, coalesce(cbpam.balance_amount, 0) as balance_amount
from data_scaffold ds 
left join txn_amount_per_active_month cbpam
on ds.customer_id = cbpam.customer_id
and ds.txn_month = cbpam.txn_month
),

// Calculate running sum 
closing_balance_per_month as (select customer_id
, txn_month
, balance_amount
, sum(balance_amount) over(
    partition by customer_id
    order by txn_month
) as closing_balance_per_month
from txn_amount_per_month
),

/* 
