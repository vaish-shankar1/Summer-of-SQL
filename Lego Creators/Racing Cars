// Lego Creator - SQL Portfolio Project   

// Step 1: Create database, read all data and set up schema (1 time set up)

// Create personal schema (use CREATE OR REPLACE to avoid an error if it already exists)
create or replace schema TIL_PORTFOLIO_PROJECTS.VAISH_LEGO;

// Assign where the schema should sit
use database TIL_PORTFOLIO_PROJECTS;
use schema STAGING;

// Create tables required (identified 5 for analysis) and insert staging data into my schama
// 1. THEMES -  Each record represents a single theme and includes details about its name and relationships to other themes.
create table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.THEMES like TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_THEMES;

insert into TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.THEMES 
select * from TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_THEMES;

// 2. SETS - Each record represents a single set and includes details about its theme, release year etc. 
create table  TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.SETS like TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_SETS;

insert into TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.SETS 
select * from TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_SETS;

//  3. INVENTORIES - Each record represents a single set and id.
create table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORIES like TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_INVENTORIES;

insert into TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORIES 
select * from TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_INVENTORIES;

// 4. COLORS - Each record represents a specific colour and RGB value (equivalent).
create table  TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.COLORS like TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_COLORS;

insert into TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.COLORS 
select * from TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_COLORS;

// 5. INVENTORY_PARTS - Each record represents a single part and includes details about its color and quantity.
create table  TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORY_PARTS LIKE TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_INVENTORY_PARTS;

insert into TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORY_PARTS 
select * from TIL_PORTFOLIO_PROJECTS.STAGING.LEGO_INVENTORY_PARTS;


// Make official database schema i.e. assign primary/foreign keys - using lego schema
// Start with primary keys
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORIES 
add primary key (id);
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORY_PARTS
add primary key (inventory_id);
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.COLORS
add primary key (id);
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.SETS 
add primary key (set_num);
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.THEMES
add primary key (id);

// No foreign keys
// 1. Connect 'sets' to 'themes' (sets.theme_id points to themes.id)
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.SETS 
add foreign key (theme_id) references TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.THEMES(id);

// 2. Connect 'inventories' to 'sets' (inventories.set_num points to sets.set_num)
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORIES 
add foreign key (set_num) references TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.SETS(set_num);

// 3. Connect 'inventory_parts' to 'inventories' (inventory_parts.inventory_id points to inventories.id)
alter table TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORY_PARTS 
add foreign key (inventory_id) references  TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORIES(id);

// 4. Connect 'inventory_parts' to 'colors' (inventory_parts.color_id points to colors.id)
alter table  TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORY_PARTS 
add foreign key (color_id) references  TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.COLORS(id);


// Check correct population of tables and schema
select 'Colors' as table_name, count(*) from TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.COLORS union all 
select  'Sets', count(*) from TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.SETS union all
select  'Themes', count(*) from TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.THEMES union all
select 'Inventories', count(*) from TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORIES union all
select  'Inventory Parts', count(*) from TIL_PORTFOLIO_PROJECTS.VAISH_LEGO.INVENTORY_PARTS;




