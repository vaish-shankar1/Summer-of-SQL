//first join transactiond etails and path as same number of rows
with transactions as (select *
from pd2023_wk07_transaction_detail td
inner join pd2023_wk07_transaction_path tp
on td.transaction_id = tp.transaction_id
where cancelled_ != 'Y'
// check no nulls with
// and tp.transaction_id is not null or td.transaction_id is not null
),

// use lateral split to table for account info = joint accounts (1 account holder id for each row) - this explains the difference in the 2 datasets of 72 rows
updated_account_info as (select account_number
, account_type
, value as account_holder_id 
, balance_date
, balance
from pd2023_wk07_account_information, // remember comma as part of from clause
lateral split_to_table(account_holder_id, ',')
),

// now number of rows match account holders table to join
accounts as (select *
from pd2023_wk07_account_holders as ah
inner join updated_account_info uai
on ah.account_holder_id = uai.account_holder_id
where account_type != 'Platinum'
)

//combine transactions with accounts
select a.account_to
, t.transaction_date
, t.value
, a.account_number
, a.account_type
, a.balance_date
, a.balance
, a.name
, a.date_of_birth
, a.contact_number
, a.first_line_of_address
from transactions t
inner join accounts a
    on t.account_from = a.account_number
where t.value > 1000;

