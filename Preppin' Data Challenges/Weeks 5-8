// set up no sign for financial metrics
trades as (select * exclude purchase_price
, replace(market_cap, '$', '') as market_cap_no_sign
, replace(purchase_price, '$', '') as purchase_price_no_sign
    from union_trades
),

// add in categorisations 
currency_trades as (select *
exclude (market_cap, market_cap_no_sign, purchase_price_no_sign, month, first_name, last_name)
, purchase_price_no_sign as purchase_price
, concat('01', '/', month, '/', '2023') as file_date
, case
    when market_cap_no_sign like '%B' then to_double(replace(market_cap_no_sign, 'B', '')) * 1000000000
    when market_cap_no_sign like '%M' then to_double(replace(market_cap_no_sign, 'M', ''))  * 1000000
    else NULL
    end as market_capitalisation
, case 
    when to_double(purchase_price_no_sign) < 25000 then 'Low'
    when to_double(purchase_price_no_sign) < 50000 then 'Medium'
    when to_double(purchase_price_no_sign) < 75000 then 'High'
    when to_double(purchase_price_no_sign) <= 100000 then 'Very High'
    end as purchase_price_category
, case 
    when market_capitalisation <100000000 then 'Small'
    when market_capitalisation <1000000000 then 'Medium'
    when market_capitalisation <100000000000 then 'Large'
    when market_capitalisation >= 100000000000 then 'Huge'
    end as market_cap_category
, rank() over (
    partition by file_date, purchase_price_category, market_cap_category
    order by market_capitalisation desc
    ) as rank
from trades
qualify market_capitalisation is not null 
and rank <= 5
)

select * 
from currency_trades
order by file_date, purchase_price_category, market_cap_category, rank asc;
