// 2023 - week 06 - 1 output

//Mobile ratings only
with mobile as (select customer_id
, replace(mobile_preference, 'MOBILE_APP___', '') AS mobile_preference
, mobile_rating
from pd2023_wk06_dsb_customer_survey
unpivot (mobile_rating for mobile_preference in (MOBILE_APP___EASE_OF_USE, MOBILE_APP___EASE_OF_ACCESS, MOBILE_APP___NAVIGATION, MOBILE_APP___LIKELIHOOD_TO_RECOMMEND))
),

//Online ratings only
online as (select customer_id
, replace(online_preference, 'ONLINE_INTERFACE___', '') AS online_preference
, online_rating
from pd2023_wk06_dsb_customer_survey
unpivot (online_rating for online_preference in (ONLINE_INTERFACE___EASE_OF_USE, ONLINE_INTERFACE___EASE_OF_ACCESS, ONLINE_INTERFACE___NAVIGATION, ONLINE_INTERFACE___LIKELIHOOD_TO_RECOMMEND))
),

//Join on preference for each customer (so 5 rows per customer)
main_table as (select m.customer_id
, mobile_preference as preference
, mobile_rating
, online_rating
from mobile m
inner join online o
    on m.customer_id = o.customer_id
    and mobile_preference = online_preference
),

// Avg preference for each customer (so 1 row per customer) and work out difference for categorisation 
customer_avg as (select customer_id
, avg(mobile_rating) as avg_mobile_rating
, avg(online_rating) as avg_online_rating
, avg(mobile_rating) - avg(online_rating) as difference
, case
    when avg(mobile_rating) - avg(online_rating) >=2 then 'mobile_app_superfans' 
    when avg(mobile_rating) - avg(online_rating) >=1 then 'mobile_app_fans' 
    when avg(mobile_rating) - avg(online_rating) <=-2 then 'online_interface_superfans' 
    when avg(mobile_rating) - avg(online_rating) <= -1 then 'online_interface_fans' 
    else 'neutral'
   end as preference
from main_table
group by customer_id
)

// Retrieve final data (5 rows) select preference
, round(count(*)::float / sum(count(*))  over()* 100, 2) as pct_of_total
from customer_avg
group by preference
order by pct_of_total asc;

