// 2023 - week 05 - 1 output
// use week 01 output
with month_transactions as (select month(to_date(transaction_date, 'DD/MM/YYYY HH24:MI:SS')) as month_number
, to_char(to_date(transaction_date, 'DD/MM/YYYY HH24:MI:SS'), 'MMMM') as month
, split_part(transaction_code, '-', 1) as bank
, sum(value) as total_value
, rank() over(
    partition by month
    order by sum(value) desc
    ) as bank_rank_per_month
from pd2023_wk01
group by month_number, month, bank
order by month_number asc, total_value desc
)

select month
, bank
, total_value
, avg(total_value) over(
    partition by bank_rank_per_month
) as avg_transaction_value_per_rank
, avg(bank_rank_per_month) over(
    partition by bank
) as avg_rank_per_bank
from month_transactions;

